      "dependencies": [
        "C0A7C3C1C2EE40FF"
      ]
    },
    {
      "id": "4F30DF8D1CCF70D3",
      "title": "听见铃声",
      "description": [
        "使用结缘铃呼唤一只附近且可达的自家猫。",
        "操作与配方详见游戏内观察手册（书 + 生鳕鱼）。",
        "材料：铜锭、粉红色染料、铜锭／铜锭、紫水晶碎片、铜锭／空格、线、空格。",
        "用铃右键自家的驯服猫选中它。退几步，潜行对空气右键呼唤。只呼唤16格内已加载且有路可达的猫。",
        "对空气右键查看伙伴和上次位置。在附近剑灵的详情中可召回原剑，原槽或虚化剑槽须可用。"
      ],
      "x": 2.0,
      "y": 12.0,
      "tasks": [
        {
          "id": "2FBE80D0009B8E00",
          "type": "advancement",
          "advancement": "absmod:progression/cat_bell",
          "criterion": ""
