  "quests": [
    {
      "id": "6B3C47D1AA6174D9",
      "title": "朝夕相伴",
      "description": [
        "交流、赠送生鳕鱼、活跃同行或战斗获得好感，每日奖励有上限。",
        "操作与配方详见游戏内观察手册（书 + 生鳕鱼）。",
        "查看剑灵关系：先显现自家剑灵，持结缘铃对空气右键，再点击剑灵。面板显示好感、下阶门槛和今日记录。空手右键交流，手持生鳕鱼右键赠礼。完成后重开详情，或点击「刷新」。"
      ],
      "x": 6.0,
      "y": 0.0,
      "tasks": [
        {
          "id": "4E0134A185A782CF",
          "type": "advancement",
          "advancement": "absmod:progression/bond",
          "criterion": ""
        }
      ],
